{
  "name": "proyecto-conecta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build",
    "check": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test:unit": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:performance": "node scripts/performance-contracts.mjs",
    "test:security": "node scripts/security-contracts.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:iphone": "playwright test --project=webkit-iphone",
    "test:accessibility": "playwright test -g accessibility",
    "test": "pnpm run test:unit && pnpm run build && pnpm run test:smoke && pnpm run test:performance && pnpm run test:security && pnpm run test:e2e",
    "validate": "pnpm run lint && pnpm run check && pnpm run test:unit && pnpm run build && pnpm run test:smoke && pnpm run test:performance && pnpm run test:security && pnpm run test:e2e"
  },
  "dependencies": {
    "@sentry/react": "10.73.0",
    "@supabase/supabase-js": "2.112.4",
    "lucide-react": "1.31.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.0.13",
    "vitest": "5.0.0"
  }
}
